{
  "name": "angusjs",
  "version": "0.1.0",
  "description": "The application framework for Elysia \u2014 define your model once and derive the schema, API, docs, admin and agent tools from it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "angus": "./src/cli/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./db": "./src/db/index.ts",
    "./serializers": "./src/serializers/index.ts",
    "./routing": "./src/routing/index.ts",
    "./services": "./src/services/index.ts",
    "./auth": "./src/auth/index.ts",
    "./email": "./src/email/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./storage": "./src/storage/index.ts",
    "./cache": "./src/cache/index.ts",
    "./admin": "./src/admin/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./client": "./src/client/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./realtime": "./src/realtime/index.ts",
    "./testing": "./src/testing/index.ts",
    "./http": "./src/http/index.ts",
    "./env": "./src/core/env.ts"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "elysia",
    "elysiajs",
    "bun",
    "api",
    "framework",
    "orm",
    "drizzle",
    "admin",
    "openapi",
    "mcp"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29"
  },
  "peerDependencies": {
    "drizzle-kit": "^0.31.10",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2"
  }
}
