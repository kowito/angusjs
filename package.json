{
  "name": "angusjs",
  "version": "0.1.0",
  "description": "A batteries-included API framework for Bun — Django's ergonomics on top of ElysiaJS.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "angus": "./src/cli/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./serializers": "./src/serializers/index.ts",
    "./routing": "./src/routing/index.ts",
    "./admin": "./src/admin/index.ts",
    "./http": "./src/http/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["elysia", "bun", "django", "api", "framework", "orm", "drizzle"],
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29"
  },
  "peerDependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependenciesMeta": {
    "@elysiajs/openapi": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2"
  }
}
